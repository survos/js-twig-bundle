{# templates/components/js_twig.html.twig #}

{% set _sc = '@survos/js-twig/js_twig' %}
<script type="application/json" id="{{ this.jsTwigScriptTagId }}" data-jstwig-role="blocks">
    {{ this.twigBlocks|json_encode|raw }}
</script>
<script type="application/json" data-jstwig-role="manifest" data-jstwig-id="{{ this.jsTwigScriptTagId }}">
    {{ this.jsTwigManifest|json_encode|raw }}
</script>

<div {{ stimulus_controller(_sc, {
    blocks: this.twigBlocks,
    scriptTagId: this.jsTwigScriptTagId,
    apiUrl: this.apiUrl|default(null),
    data: data|default(false),
    globals: {
        isAdmin: is_granted('ROLE_ADMIN')
    }
}) }}>

    <div {{ stimulus_target(_sc, 'message') }}>
        a message here.
    </div>

</div>

{{ jstwig_debug_panel() }}
